# Core
RAG__ENV=development
RAG__DEBUG=false
RAG__LOG_LEVEL=info

# Server
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=1

# Backend security
RAG__SECURITY__API_KEY_REQUIRED=true
RAG__SECURITY__API_KEYS=your_api_key_one,your_api_key_two
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ORIGINS=http://localhost:3000
RAG__SECURITY__CORS_ALLOW_CREDENTIALS=true

# Backend data and stores
NEXUSRAG_DATA_DIR=./data
QDRANT_URL=./data/qdrant
QDRANT_API_KEY=
REDIS_URL=

# Provider credentials
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Frontend / public web app
BACKEND_API_URL=http://localhost:8000
BACKEND_SERVICE_API_KEY=your_api_key_one
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NEXUSRAG_PUBLIC_APP=true
NEXT_PUBLIC_NEXUSRAG_APP_NAME=NexusRAG
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
