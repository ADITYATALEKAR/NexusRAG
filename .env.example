# Cloudflare Pages public variables (safe to expose in the browser)
NEXT_PUBLIC_API_BASE_URL=https://your-koyeb-backend.koyeb.app
NEXT_PUBLIC_NEXUSRAG_APP_NAME=NexusRAG
NEXT_PUBLIC_NEXUSRAG_PUBLIC_APP=true
NEXT_PUBLIC_NEXUSRAG_DEPLOYMENT_TARGET=cloudflare-pages-koyeb-neon
NEXT_PUBLIC_NEXUSRAG_EXTERNAL_BACKEND=true
NEXT_PUBLIC_NEXUSRAG_REQUIRE_OPERATOR_LOGIN=false

# Koyeb / backend server-only variables
PORT=8000
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
NEON_DATABASE_URL=
RAG__ENV=production
RAG__DEBUG=false
RAG__LOG_LEVEL=info
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=1
RAG__SECURITY__API_KEY_REQUIRED=false
RAG__SECURITY__API_KEYS=
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ORIGINS=https://your-cloudflare-pages-domain.pages.dev
RAG__SECURITY__CORS_ALLOW_CREDENTIALS=false
NEXUSRAG_PUBLIC_DEMO_MODE=true
NEXUSRAG_UPLOAD_DIR=/tmp/nexusrag-uploads
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional operator/self-host mode
BACKEND_SERVICE_API_KEY=
