# Core
RAG__ENV=development
RAG__DEBUG=false
RAG__LOG_LEVEL=info

# Server
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=1

# Backend security
RAG__SECURITY__API_KEY_REQUIRED=false
RAG__SECURITY__API_KEYS=your_api_key_one,your_api_key_two
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ORIGINS=http://localhost:3000

# Provider credentials
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Frontend / auth
BACKEND_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
