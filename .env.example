# Frontend / Vercel public variables (safe to expose in the browser)
NEXT_PUBLIC_NEXUSRAG_APP_NAME=NexusRAG
NEXT_PUBLIC_NEXUSRAG_PUBLIC_APP=true
NEXT_PUBLIC_NEXUSRAG_DEPLOYMENT_TARGET=vercel-supabase
NEXT_PUBLIC_NEXUSRAG_EXTERNAL_BACKEND=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documents

# Frontend / Vercel server-only variables
BACKEND_API_URL=
BACKEND_SERVICE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret_if_using_nextauth

# Optional separate Python backend settings (only needed when you deploy the FastAPI RAG service later)
RAG__ENV=development
RAG__DEBUG=false
RAG__LOG_LEVEL=info
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=1
RAG__SECURITY__API_KEY_REQUIRED=true
RAG__SECURITY__API_KEYS=your_api_key_one,your_api_key_two
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ORIGINS=http://localhost:3000
RAG__SECURITY__CORS_ALLOW_CREDENTIALS=true
NEXUSRAG_DATA_DIR=./data
QDRANT_URL=./data/qdrant
QDRANT_API_KEY=
REDIS_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
