# Core
RAG__ENV=production
RAG__DEBUG=false
RAG__LOG_LEVEL=info

# Server
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=1

# Security
RAG__SECURITY__API_KEY_REQUIRED=true
RAG__SECURITY__API_KEYS=put-a-long-random-api-key-here
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ALLOW_CREDENTIALS=true
RAG__SECURITY__CORS_ORIGINS=https://app.example.com

# Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Vector store
QDRANT_URL=https://your-qdrant-host:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Redis
REDIS_URL=redis://your-redis-host:6379

# Frontend public app
BACKEND_API_URL=https://api.example.com
BACKEND_SERVICE_API_KEY=put-a-long-random-api-key-here
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_NEXUSRAG_PUBLIC_APP=true
NEXT_PUBLIC_NEXUSRAG_APP_NAME=NexusRAG
NEXTAUTH_URL=https://app.example.com
NEXTAUTH_SECRET=replace_with_a_long_random_secret
