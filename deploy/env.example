# Core
RAG__ENV=development
RAG__DEBUG=false
RAG__LOG_LEVEL=info

# Server
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=4

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379

# Security
RAG__SECURITY__API_KEYS=your_api_key_one,your_api_key_two
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ORIGINS=https://app.example.com
