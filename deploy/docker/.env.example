# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# API runtime
RAG__ENV=production
RAG__DEBUG=false
RAG__SERVER__HOST=0.0.0.0
RAG__SERVER__PORT=8000
RAG__SERVER__WORKERS=1
RAG__SECURITY__API_KEY_REQUIRED=true
RAG__SECURITY__API_KEYS=put-a-long-random-api-key-here
RAG__SECURITY__RATE_LIMIT_ENABLED=true
RAG__SECURITY__CORS_ALLOW_CREDENTIALS=true
RAG__SECURITY__CORS_ORIGINS=http://localhost:3000
NEXUSRAG_DATA_DIR=/app/data
QDRANT_URL=/app/data/qdrant
QDRANT_API_KEY=
REDIS_URL=redis://redis:6379

# Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Frontend public app
BACKEND_API_URL=http://api:8000
BACKEND_SERVICE_API_KEY=put-a-long-random-api-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NEXUSRAG_PUBLIC_APP=true
NEXT_PUBLIC_NEXUSRAG_APP_NAME=NexusRAG
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
